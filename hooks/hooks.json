{
  "description": "casefile: session-start pointer to the evidence skill, and the guards of the 0.13.0 spec. Every guard fails closed.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook\" session_start",
            "async": false
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook\" guard_bash",
            "onFailure": "block",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook\" pre_commit",
            "onFailure": "block",
            "timeout": 900,
            "statusMessage": "casefile: checking the commit"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook\" guard_paths",
            "onFailure": "block",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook\" design_check",
            "onFailure": "block",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
